{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONest",
  "version": "0.0.1",
  "identifier": "com.nununuuuu.conest",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright © 2025 btjawa",
    "createUpdaterArtifacts": false,
    "homepage": "https://github.com/nununuuuu/CONest",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "license": "GPL-3.0-or-later",
    "publisher": "nununuuuu",
    "shortDescription": "CONest - Bilibili media toolbox",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "REPLACE_WITH_YOUR_TAURI_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/nununuuuu/CONest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
